# Vorlage für die lokale .env und Quelle für configmap.env im Cluster.

# Pfad der geteilten SQLite-Datei (Interim). Volume SCHREIBBAR mounten: das
# Backend schreibt die Bewertungseingaben nach UserEvaluationInputs.
GRID_CON_DB_PATH=/data/db/grid_con.db

# --- Auth (eg-auth) ---
# Im Cluster: False. True umgeht die OIDC-Prüfung — nur lokal.
EG_AUTH_DEV_MODE=True
EG_AUTH_DEV_GROUPS=["app_50hzt_aap_communities_all__x"]
# Lokal: angemeldete Nutzer:in (E-Mail aus Users, um bewerten zu können)
EG_AUTH_DEV_EMAIL=dev.user@example.com

# --- BronzeToGold nach jeder Bewertung auslösen (optional) ---
# Airflow 2.10 (Plattform): v1 mit Token oder Basic Auth; Airflow 3 lokal: v2.
AIRFLOW_API_URL=
AIRFLOW_API_VERSION=v1
AIRFLOW_API_TOKEN=
AIRFLOW_API_USERNAME=
AIRFLOW_API_PASSWORD=
GRID_CON_GOLD_DAG_ID=grid_con_bronze_to_gold
