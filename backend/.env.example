# Vorlage für die lokale .env und Quelle für configmap.env im Cluster.

# Pfad der geteilten SQLite-Datei (Interim, Volume schreibbar gemountet, wegen der Bewertungseingaben).
GRID_CON_DB_PATH=/data/db/grid_con.db

# Optional: Airflow-REST-API, um nach einer Bewertung den DAG BronzeToGold
# sofort auszulösen. Ohne Wert greift dessen Zeitplan.
AIRFLOW_API_URL=
AIRFLOW_API_TOKEN=
AIRFLOW_API_USERNAME=
AIRFLOW_API_PASSWORD=
GRID_CON_GOLD_DAG_ID=grid_con_bronze_to_gold
