# Copy to .env.local (local) or set in the build environment.
# Vite bakes VITE_* in at build time, not at runtime.

# Base path of the backend API. Default: /api/v1 (the dev server proxies /api).
VITE_API_BASE="/api/v1"

# C4C ticket link; {id} is replaced by the ticket ID (id_gronos_new).
# Empty: the detail panel shows the C4C link as "nicht konfiguriert".
VITE_C4C_TICKET_URL=""
