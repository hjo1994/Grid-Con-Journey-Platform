# Local development. Vite forwards /api to the local backend (see vite.config.ts).
VITE_API_BASE="/api/v1"

# OIDC (eg-auth-react). Left empty on purpose: the values belong to the company
# network (AAP authenticator) and are filled in there, see README.
# Outside the company network use the dev bypass instead (.env.development.local).
VITE_OIDC_CLIENT_ID=""
VITE_OIDC_AUTHORITY=""
# Comma-separated AD groups requested as scopes. Placeholder group from the
# AI Cockpit — replace together with the backend's group (app/auth.py).
VITE_OIDC_REQUEST_GROUPS="app_50hzt_aap_communities_all__x"
