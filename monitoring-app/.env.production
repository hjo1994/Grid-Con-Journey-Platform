# Production build (npm run build). /api is routed to the backend by the deployment.
VITE_API_BASE="/api/v1"

# OIDC (eg-auth-react): register an own OIDC client for Grid Con and enter its
# values here on the company side. The redirect URI is window.location.origin + "/"
# and must be registered exactly, once per stage/domain.
VITE_OIDC_CLIENT_ID=""
VITE_OIDC_AUTHORITY=""
VITE_OIDC_REQUEST_GROUPS="app_50hzt_aap_communities_all__x"
